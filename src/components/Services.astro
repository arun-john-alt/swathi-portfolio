---
import site from '../data/site.json';
import Frame from './Frame.astro';
import { isPlaceholderText, placeholderLabel } from '../lib/placeholder';
---

<Frame id="services" name="Services" labelledby="services-title">
  <div class="board__head">
    <h2 id="services-title">What I build</h2>
  </div>

  <div class="services">
    {
      site.services.map((s, i) =>
        isPlaceholderText(s.name) ? (
          <div class="service service--ph">
            <span class="ph-tag">Placeholder</span>
            <p>{placeholderLabel(s.name)}</p>
          </div>
        ) : (
          <article class="service" data-enter style={`--i:${i}`}>
            <h3>{s.name}</h3>
            <p class="service__summary">{s.summary}</p>
            {s.items.length > 0 && (
              <ul class="service__list">
                {s.items.map((item, j) => (
                  <li style={`--j:${j}`}>{item}</li>
                ))}
              </ul>
            )}
          </article>
        ),
      )
    }
  </div>
</Frame>

<style>
  .services {
    display: grid;
    gap: 40px;
  }

  .service {
    --d: 0ms; /* desktop staggers the three side by side */
    position: relative;
    padding-top: 16px;
  }
  /* The heavy rule on top, a separate line so it can be drawn. */
  .service:not(.service--ph)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--ink);
    transform-origin: left;
  }

  .service h3 {
    margin-top: 4px;
    font-size: clamp(1.625rem, 1.3rem + 1.4vw, 2.5rem);
    font-weight: 700;
  }

  .service__summary {
    margin-top: 12px;
    color: var(--ink-2);
    max-width: 44ch;
  }

  .service__list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .service__list li {
    display: flex;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .service__list li::before {
    content: '+';
    font-family: var(--mono);
    color: var(--muted);
  }

  .service--ph {
    display: grid;
    gap: 10px;
    justify-items: start;
    padding: 20px;
    border: 1px dashed var(--line-strong);
    color: var(--muted);
  }

  @media (min-width: 800px) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(32px, 5vw, 72px);
      row-gap: 48px;
    }
    .service--ph {
      grid-column: 1 / -1;
      grid-template-columns: auto 1fr;
      align-items: center;
    }
  }

  /* Three services sit side by side once there is room for three readable columns. */
  @media (min-width: 1100px) {
    .services {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(32px, 3.5vw, 56px);
    }
  }
  @media (min-width: 800px) {
    .service {
      --d: calc(var(--i, 0) * 140ms);
    }
  }

  /* ---------- As each service enters: its rule is drawn, then its list is set item by item ---------- */

  :global(.motion) .service:not(:global(.is-in))::before {
    transform: scaleX(0);
  }
  :global(.motion) .service:not(:global(.is-in)) .service__list li {
    opacity: 0;
  }

  :global(.motion) .service:global(.is-in)::before {
    animation: rule-draw 640ms var(--ease-expo) var(--d) backwards;
  }
  :global(.motion) .service:global(.is-in) .service__list li {
    animation: item-set 420ms var(--ease-expo) backwards;
    animation-delay: calc(var(--d) + 320ms + var(--j, 0) * 70ms);
  }
  :global(.motion) .service:global(.is-in) .service__list li::before {
    display: inline-block;
    animation: plus-set 360ms var(--ease-expo) backwards;
    animation-delay: calc(var(--d) + 320ms + var(--j, 0) * 70ms);
  }

  @keyframes rule-draw {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes item-set {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
  }
  @keyframes plus-set {
    from {
      transform: rotate(-90deg) scale(0.4);
    }
  }
</style>
