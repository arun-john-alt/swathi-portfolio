---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import site from '../data/site.json';
import Frame from './Frame.astro';
import { isPlaceholderText } from '../lib/placeholder';

// Drop one photo into src/assets/about/ and it is used here automatically.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/about/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const photo = Object.values(photos)[0]?.default;
const { about } = site;
---

<Frame id="about" name="About" labelledby="about-title">
  <!-- Phones: heading, photo, text. Wider screens: photo on the left, heading and text on the right. -->
  <div class="about">
    <h2 id="about-title" class="about__head">{about.heading}</h2>

    <div class="about__photo">
      {
        photo ? (
          <Image
            src={photo}
            alt={`Portrait of ${site.name}`}
            widths={[400, 700, 1000]}
            sizes="(min-width: 800px) 36vw, 280px"
          />
        ) : (
          <div class="ph-box">
            <span class="ph-box__label mono">
              <span>Photo of {site.name}</span>
              <span>src/assets/about/</span>
            </span>
          </div>
        )
      }
    </div>

    <div class="about__body">
      {about.paragraphs.map((para) => <p>{para}</p>)}

      <h3 class="about__tools-title mono">Tools</h3>
      <ul class="tools">
        {
          about.tools.map((tool) =>
            isPlaceholderText(tool) ? (
              <li class="tool tool--ph">tool to add</li>
            ) : (
              <li class="tool">{tool}</li>
            ),
          )
        }
      </ul>
    </div>
  </div>
</Frame>

<style>
  .about {
    display: grid;
    grid-template-areas:
      'head'
      'photo'
      'body';
    gap: 24px;
  }

  .about__head {
    grid-area: head;
    font-size: clamp(2rem, 1.4rem + 3vw, 3.5rem);
    font-weight: 700;
  }

  .about__photo {
    grid-area: photo;
    width: 100%;
    max-width: 280px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .about__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%; /* keep her face in frame when the box crops */
  }

  .about__body {
    grid-area: body;
  }
  .about__body p {
    color: var(--ink-2);
    max-width: 58ch;
  }
  .about__body p + p {
    margin-top: 14px;
  }

  .about__tools-title {
    margin-top: 32px;
    color: var(--muted);
    font-weight: 400;
    letter-spacing: 0;
  }

  .tools {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tool {
    padding: 6px 12px;
    border: 1px solid var(--ink);
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .tool--ph {
    border: 1px dashed var(--line-strong);
    color: var(--muted);
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.8125rem;
  }

  @media (min-width: 800px) {
    .about {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'photo head'
        'photo body';
      column-gap: clamp(32px, 5vw, 80px);
      row-gap: 20px;
      align-items: start;
    }
    .about__photo {
      max-width: none;
    }
  }
</style>
