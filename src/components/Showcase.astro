---
// The live site on a desktop screen with the phone view in front of it, both real screenshots.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  desktop: ImageMetadata;
  phone: ImageMetadata;
  eager?: boolean;
}
const { title, desktop, phone, eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---

<div class="showcase">
  <figure class="showcase__desk">
    <Image
      src={desktop}
      alt={`${title} on a desktop screen`}
      widths={[480, 720, 960, 1440]}
      sizes="(min-width: 1024px) 52vw, 88vw"
      loading={loading}
    />
    <figcaption class="showcase__tag mono">Desktop · 1440</figcaption>
  </figure>
  <figure class="showcase__phone">
    <Image
      src={phone}
      alt={`${title} on a phone`}
      widths={[160, 240, 360, 520]}
      sizes="(min-width: 1024px) 15vw, 26vw"
      loading={loading}
    />
    <figcaption class="showcase__tag mono">Phone · 390</figcaption>
  </figure>
</div>

<style>
  /* The desktop screen takes most of the width; the phone stands in front of its lower right corner. */
  .showcase {
    position: relative;
    padding-bottom: 15%;
  }

  .showcase figure {
    margin: 0;
  }

  .showcase__desk {
    position: relative;
    width: 88%;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
    background: var(--hatch-a);
    overflow: hidden;
  }

  .showcase__phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 25%;
    aspect-ratio: 390 / 844;
    border: 4px solid var(--ink);
    border-radius: 18px;
    background: var(--ink);
    overflow: hidden;
    box-shadow: 0 18px 36px -16px rgba(0, 0, 0, 0.45);
  }

  .showcase :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .showcase__phone :global(img) {
    border-radius: 13px;
  }

  .showcase__tag {
    position: absolute;
    left: 8px;
    top: 8px;
    padding: 1px 6px;
    border-radius: 3px;
    background: var(--ink);
    color: #fff;
    font-size: 0.75rem;
  }

  /* On the phone frame the tag sits above it, so it doesn't cover the screen. */
  .showcase__phone .showcase__tag {
    display: none;
  }

  @media (min-width: 600px) {
    .showcase__phone .showcase__tag {
      display: block;
    }
    .showcase__phone {
      overflow: visible;
    }
    .showcase__phone .showcase__tag {
      top: -30px;
      left: -4px;
      white-space: nowrap;
    }
  }
</style>
