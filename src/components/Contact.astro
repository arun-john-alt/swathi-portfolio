---
import site from '../data/site.json';
import Frame from './Frame.astro';
import { whatsappUrl } from '../lib/placeholder';

const c = site.contact;
const links: { label: string; url: string; display?: string }[] = c.links;
// Channels with no number, address or link yet are left out: fill them in site.json and they appear.
const channels = [
  {
    label: 'WhatsApp',
    value: c.whatsapp,
    href: whatsappUrl(c.whatsapp, c.whatsappMessage),
    missing: 'Number to add',
    external: true,
  },
  {
    label: 'Email',
    value: c.email,
    href: c.email ? `mailto:${c.email}` : '',
    missing: 'Address to add',
    external: false,
  },
  ...links.map((l) => ({
    label: l.label,
    value: l.display || (l.url ? l.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '') : ''),
    href: l.url,
    missing: 'Link to add',
    external: true,
  })),
].filter((ch) => ch.href);
---

<Frame id="contact" name="Contact" labelledby="contact-title">
  <div class="contact" data-enter>
    <div class="contact__intro">
      <h2 id="contact-title">
        {
          c.heading.split(/\s+/).map((w, i) => (
            <>
              <span class="w">
                <span style={`--w:${i}`}>{w}</span>
              </span>{' '}
            </>
          ))
        }
      </h2>
      <p>{c.text}</p>
    </div>

    <ul class="channels">
      {
        channels.map((ch) => (
          <li>
            {ch.href ? (
              <a
                class="channel"
                href={ch.href}
                target={ch.external ? '_blank' : undefined}
                rel={ch.external ? 'noopener' : undefined}
              >
                <span class="channel__label mono">{ch.label}</span>
                <span class="channel__value">{ch.value}</span>
                <svg class="channel__arrow" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                  <path d="M6 14 14 6M7 6h7v7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
            ) : (
              <span class="channel channel--ph" title="Placeholder: add it in src/data/site.json">
                <span class="channel__label mono">{ch.label}</span>
                <span class="channel__value">{ch.missing}</span>
                <span class="ph-tag">placeholder</span>
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Frame>

<style>
  .contact {
    display: grid;
    gap: 32px;
  }

  .contact__intro h2 {
    font-size: clamp(2.25rem, 1.5rem + 4vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    max-width: 14ch;
  }
  .contact__intro p {
    margin-top: 16px;
    color: var(--ink-2);
    max-width: 44ch;
  }

  .channels {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* The ink line above the rows, a separate line so it can be drawn. */
  .channels::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--ink);
    transform-origin: left;
  }

  /* Each heading word in a mask, so the close can echo the opening. */
  .w {
    display: inline-block;
    vertical-align: top;
    overflow: clip;
    padding-bottom: 0.16em;
    margin-bottom: -0.16em;
  }
  .w > span {
    display: inline-block;
  }

  /* ---------- As the close enters: the heading rises word by word (the opening's own move, as a
     callback), the line above the rows is drawn, and the arrow gives one small "send" nudge. ---------- */

  :global(.motion) .contact:not(:global(.is-in)) .w > span {
    transform: translateY(130%);
  }
  :global(.motion) .contact:not(:global(.is-in)) .channels::before {
    transform: scaleX(0);
  }
  :global(.motion) .contact:not(:global(.is-in)) .contact__intro p,
  :global(.motion) .contact:not(:global(.is-in)) .channel {
    opacity: 0;
  }

  :global(.motion) .contact:global(.is-in) .w > span {
    animation: word-rise 640ms var(--ease-expo) backwards;
    animation-delay: calc(var(--w) * 45ms);
  }
  :global(.motion) .contact:global(.is-in) .contact__intro p {
    animation: close-settle 520ms var(--ease-expo) 420ms backwards;
  }
  :global(.motion) .contact:global(.is-in) .channels::before {
    animation: line-in 700ms var(--ease-drag) 520ms backwards;
  }
  :global(.motion) .contact:global(.is-in) .channel {
    animation: close-settle 480ms var(--ease-expo) 820ms backwards;
  }
  :global(.motion) .contact:global(.is-in) a.channel .channel__arrow {
    animation: send-nudge 700ms var(--ease-expo) 1300ms;
  }

  @keyframes word-rise {
    from {
      transform: translateY(130%);
    }
  }
  @keyframes close-settle {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes line-in {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes send-nudge {
    0%,
    100% {
      translate: 0 0;
    }
    40% {
      translate: 5px -5px;
    }
  }

  .channel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'label end'
      'value end';
    align-items: center;
    column-gap: 16px;
    min-height: 72px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .channel__label {
    grid-area: label;
    color: var(--muted);
  }
  .channel__value {
    grid-area: value;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .channel__arrow,
  .channel .ph-tag {
    grid-area: end;
  }
  .channel__arrow {
    font-size: 1.25rem;
    transition: transform 160ms var(--ease-out);
  }

  .channel--ph .channel__value {
    color: var(--muted);
    font-weight: 500;
  }

  @media (hover: hover) {
    a.channel:hover .channel__value {
      color: var(--select);
    }
    a.channel:hover .channel__arrow {
      transform: translate(2px, -2px);
      color: var(--select);
    }
  }

  @media (min-width: 1024px) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 64px;
      align-items: start;
    }
  }
</style>
